    "core.resolutionHelp": {
      "extractionState": "manual",
      "comment": "Product core: resolutionHelp",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For scene wallpapers on the desktop. Standard renders at logical window resolution; HiDPI uses the screen’s full pixel density. The quality profile may reduce the render size."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für Szenen-Hintergrundbilder auf dem Desktop. Standard rendert mit der logischen Fensterauflösung; HiDPI nutzt die volle Pixeldichte des Bildschirms. Das Qualitätsprofil kann die Rendergröße reduzieren."
          }
        }
      }
    },
