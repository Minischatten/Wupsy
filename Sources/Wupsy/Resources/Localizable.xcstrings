    "editor.maskImportHint": {
      "comment": "Editor effects/paint (12.4C.2): maskImportHint. Presentation only; technical IDs and paint semantics stay unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a mask image for the effect.\nWhite areas receive the full effect, black areas receive none, and gray areas receive a partial effect.\nFor color images, the red channel is used. Transparency is ignored."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Maskenbild für den Effekt auswählen.\nWeiße Bereiche erhalten den vollen Effekt, schwarze keinen und graue einen anteiligen Effekt.\nBei Farbbildern wird der Rotkanal verwendet. Transparenz wird ignoriert."
          }
        }
      }
    },
