    "editor.rainEraseHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brush paints where rain appears. To erase from a full mask, create a mask and fill it first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pinsel malt den Regenbereich. Zum Radieren aus einer vollen Maske zuerst eine Maske erstellen und füllen."
          }
        }
      }
    },
    "editor.rainCapacity": {
      "extractionState": "manual",
      "localizations": {
