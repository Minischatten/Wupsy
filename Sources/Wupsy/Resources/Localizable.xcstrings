        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag wurde entfernt, seine verwalteten Dateien konnten jedoch nicht vollständig gelöscht werden. Externe Originaldateien bleiben erhalten."
          }
        }
      }
    },
