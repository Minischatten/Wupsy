    "startupRecovery.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wupsy cannot start because recovery could not be completed safely. Quit Wupsy and try opening it again. Recovery data has been retained.\n\nTechnical details: %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wupsy kann nicht starten, da die Wiederherstellung nicht sicher abgeschlossen werden konnte. Beende Wupsy und öffne es erneut. Die Wiederherstellungsdaten wurden aufbewahrt.\n\nTechnische Details: %1$@"
          }
        }
      }
    },
