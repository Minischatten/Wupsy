    "widget.codeHint": {
      "comment": "Widget presentation only; technical identity and user content remain unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live fields: data-ambient=\"time\", \"date\", \"cpu\", \"memory\", \"download\", \"upload\". CSS receives --cpu and --memory as percentages. Use inline HTML/CSS or embedded data images. External resources and page JavaScript are disabled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Werte: data-ambient=\"time\", \"date\", \"cpu\", \"memory\", \"download\", \"upload\". CSS erhält --cpu und --memory als Prozentwerte. Verwende Inline-HTML/CSS oder eingebettete Bilder als Data-URLs. Externe Ressourcen und JavaScript der Seite sind deaktiviert."
          }
        }
      }
    },
