    "core.managedRemoveHint": {
      "extractionState": "manual",
      "comment": "Product core: managedRemoveHint",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the wallpaper from the library and deletes its associated Wupsy-managed files. External original files are preserved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt das Wallpaper aus der Mediathek und löscht die zugehörigen von Wupsy verwalteten Dateien. Externe Originaldateien bleiben erhalten."
          }
        }
      }
    },
    "core.externalRemoveHint": {
      "extractionState": "manual",
      "comment": "Product core: externalRemoveHint",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the library entry. The original file is kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt den Eintrag aus der Mediathek. Die Originaldatei bleibt erhalten."
          }
        }
      }
    },
    "core.libraryLoadError": {
      "extractionState": "manual",
      "comment": "Product core: libraryLoadError",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The library could not be read safely. Existing files were kept. Reopen Wupsy or check the library before making changes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mediathek konnte nicht sicher gelesen werden. Vorhandene Dateien bleiben erhalten. Wupsy erneut öffnen oder die Mediathek vor weiteren Änderungen prüfen."
          }
        }
      }
    },
    "core.playbackError": {
      "extractionState": "manual",
      "comment": "Product core: playbackError",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallpaper could not be played. The library and original files were kept. Try applying it again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hintergrundbild konnte nicht wiedergegeben werden. Mediathek und Originaldateien bleiben erhalten. Bitte erneut anwenden."
          }
        }
      }
    },
    "core.removeError": {
      "extractionState": "manual",
      "comment": "Product core: removeError",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallpaper could not be removed safely. Check the library before trying again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hintergrundbild konnte nicht sicher entfernt werden. Bitte vor einem erneuten Versuch die Mediathek prüfen."
          }
        }
      }
    },
