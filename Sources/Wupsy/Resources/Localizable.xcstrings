    "widget.readingsHint": {
      "comment": "Widget presentation only; technical identity and user content remain unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network shows combined Ethernet/Wi-Fi traffic (not per-app), avoiding VPN double-counting. CPU is the average over each sample interval. RAM estimates active, wired and compressed physical memory; it differs from Activity Monitor’s Memory Used. Custom web widgets use more resources than native widgets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Netzwerk zeigt den gesamten Ethernet-/WLAN-Datenverkehr, nicht den einzelner Apps. VPN-Verkehr wird dabei nicht doppelt gezählt. Die CPU-Auslastung ist der Mittelwert des jeweiligen Messintervalls. RAM schätzt den aktiven, reservierten und komprimierten physischen Speicher; der Wert unterscheidet sich von „Speicher (belegt)“ in der Aktivitätsanzeige. Eigene Web-Widgets benötigen mehr Ressourcen als native Widgets."
          }
        }
      }
    },
