      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 keeps the centerline straight between samples. Higher values round turns and can overshoot. Does not change fading."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 hält die Mittellinie zwischen Punkten gerade. Höhere Werte runden Kurven und können überschwingen. Das Ausklingen bleibt unverändert."
          }
        }
      }
    },
